# IA: claves secretas solo en .env local o variables de entorno del proveedor
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# MySQL. Usa un usuario dedicado con permisos mínimos, no root.
DB_HOST=127.0.0.1
DB_USER=root  # solo desarrollo local con XAMPP; producción debe usar un usuario dedicado
DB_PASSWORD=
DB_NAME=fitai_style
DB_PORT=3306
DB_SLOW_QUERY_SECONDS=0.5
# Ruta al certificado CA de MySQL para verificar TLS en remoto (si aplica).
# DB_SSL_CA=/ruta/segura/mysql-ca.pem

# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
# Define este valor en el gestor de secretos del despliegue.
SECRET_KEY=
FLASK_DEBUG=0

OPENWEATHER_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Producción: dominios HTTPS exactos separados por comas.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500  # en producción, usa solo HTTPS
FORCE_HTTPS=0  # cambia a 1 en producción
TRUST_PROXY_HEADERS=1
# En producción configura Redis gestionado para límites compartidos:
# RATELIMIT_STORAGE_URI=redis://...
MAX_UPLOAD_MB=10
AVATAR_MODEL_URL=https://cdn.jsdelivr.net/gh/nirholas/three.ws@5c7d87a768152cd64a8cce2feef8831411062eb5/public/avatars/parametric-base.glb

# Firebase Admin: no subas el JSON de cuenta de servicio a Git.
# FIREBASE_SERVICE_ACCOUNT_FILE=/ruta/segura/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
