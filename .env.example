# Gemini (usada por el Consultor de imagen y por el asistente JAVES)
GEMINI_API_KEY=pega_aqui_tu_clave
GEMINI_MODEL=gemini-3.7-flash

# Base de datos (MySQL vía XAMPP en local)
# Abre el panel de control de XAMPP → inicia "MySQL" → estos son los
# valores por defecto de XAMPP (usuario root, sin contraseña).
# Antes de arrancar el backend, entra a phpMyAdmin (botón "Admin" de
# XAMPP) y crea la base "fitai_style" corriendo el archivo
# "Base de datos/base_de_datos_aufis.sql" en la pestaña SQL.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=fitai_style
DB_PORT=3306

# Seguridad / entorno
# SECRET_KEY firma los tokens de sesión (login). Ya te dejamos una
# generada y lista para usar en desarrollo. Si la cambias o la dejas
# sin definir, los usuarios con sesión iniciada deberán volver a
# iniciar sesión. Antes de publicar el sitio en internet, genera una
# tuya propia con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=genera_una_clave_segura_de_64_caracteres2
FLASK_DEBUG=0

# Clima real (OpenWeatherMap) — gratis, hasta 1000 llamadas/día
# https://openweathermap.org/api
OPENWEATHER_API_KEY=pega_aqui_tu_clave

# Búsqueda de inspiración de moda (Google Custom Search) — gratis,
# 100 búsquedas/día. Necesitas AMBAS variables:
# 1) API key: https://console.cloud.google.com/apis/credentials
# 2) Motor de búsqueda (cx): https://programmablesearchengine.google.com/
GOOGLE_API_KEY=pega_aqui_tu_clave
GOOGLE_CSE_ID=pega_aqui_tu_id_de_motor

# CORS en producción (opcional en desarrollo local)
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
MAX_UPLOAD_MB=16
# URL del GLB humano paramétrico compartido con el frontend.
AVATAR_MODEL_URL=https://cdn.jsdelivr.net/gh/nirholas/three.ws@5c7d87a768152cd64a8cce2feef8831411062eb5/public/avatars/parametric-base.glb

# Integración opcional Firebase -> JWT propio de FitAI.
# Necesaria si quieres que Google/Facebook/Email de Firebase también
# tengan acceso a las rutas protegidas de MySQL.
# No subas el JSON de la cuenta de servicio al repositorio.
FIREBASE_SERVICE_ACCOUNT_FILE=C:/ruta/segura/firebase-service-account.json
